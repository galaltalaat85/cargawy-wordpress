<?xml version="1.0"?>
<phpunit
	bootstrap="wp-content/plugins/cargawy-core/tests/bootstrap.php"
	backupGlobals="false"
	colors="true"
	convertErrorsToExceptions="true"
	convertNoticesToExceptions="true"
	convertWarningsToExceptions="true"
	convertDeprecationsToExceptions="true"
	>
	<testsuites>
		<testsuite name="cargawy-core">
			<directory suffix="Test.php">wp-content/plugins/cargawy-core/tests</directory>
		</testsuite>
	</testsuites>
	<coverage includeUncoveredFiles="true">
		<include>
			<directory suffix=".php">wp-content/plugins/cargawy-core/includes</directory>
		</include>
	</coverage>
</phpunit>
