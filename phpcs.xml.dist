<?xml version="1.0"?>
<ruleset name="CarGawy">
	<description>WordPress Coding Standards for CarGawy.</description>

	<file>wp-content/plugins/cargawy-core</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.6"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="cargawy-core"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="cargawy"/>
				<element value="CarGawy"/>
			</property>
		</properties>
	</rule>

	<!-- PSR-4 class files (includes/Foo/Bar.php) instead of class-foo-bar.php. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/includes/*</exclude-pattern>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- Tests: relaxed direct DB and doc rules. -->
	<rule ref="WordPress.DB">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="cg_access_admin"/>
				<element value="cg_submit_car"/>
				<element value="cg_edit_own_car"/>
				<element value="cg_delete_own_car"/>
				<element value="cg_mark_sold_own_car"/>
				<element value="cg_manage_inventory"/>
				<element value="cg_publish_inventory"/>
				<element value="cg_view_inventory_cost"/>
				<element value="cg_edit_others_cars"/>
				<element value="cg_moderate_listings"/>
				<element value="cg_feature_listings"/>
				<element value="cg_verify_dealers"/>
				<element value="cg_manage_dealer_profile"/>
				<element value="cg_manage_dealer_members"/>
				<element value="cg_request_inspection"/>
				<element value="cg_schedule_inspection"/>
				<element value="cg_perform_inspection"/>
				<element value="cg_approve_inspection"/>
				<element value="cg_request_legal_review"/>
				<element value="cg_perform_legal_review"/>
				<element value="cg_view_private_files"/>
				<element value="cg_view_all_leads"/>
				<element value="cg_view_own_leads"/>
				<element value="cg_manage_leads"/>
				<element value="cg_view_reports"/>
				<element value="cg_manage_seo"/>
				<element value="cg_view_audit_log"/>
				<element value="cg_manage_settings"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.runtime_configuration_putenv">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="/"/>
		</properties>
	</rule>
</ruleset>
